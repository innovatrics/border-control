# ── MCT overlay configuration (mct/docker-compose.yml) ──────────────────────────────────────
# Images: preview builds from the VPP CI pipeline, re-pushed to Harbor and pinned to the source
# revisions running in the Innovatrics reference deployment. The Harbor copies of the .NET suite
# are rebuilds of that revision rather than byte-identical mirrors, so treat these tags as
# validated-by-revision, not by digest. They move to semver tags once the MCT release train ships.
MCT_REGISTRY=registry.dot.innovatrics.com/border-control/
# .NET suite: config-api, identifier, tracking-visualizer (one shared tag)
MCT_VERSION=5de190ff-x64
# Tracking engine
MCT_TRACKER_VERSION=git-c8763f2-ci-142
# MQTT fan-out proxy (feed tap)
MCT_PROXY_VERSION=0.0.4

# Name of the calibration model in the Config API (import your site's model first — README).
MCT_MODEL=my-corridor

# Password of the base stack's `pgsql` — must match POSTGRES_PASSWORD in
# vpp/sf_dependencies/docker-compose.yml, or the config-api migration cannot connect.
MCT_DB_PASSWORD=Test1234

# SFE Stream Processor client ids (camera MACs) of YOUR corridor cameras — comma+space list.
MCT_CLIENT_IDS=AABBCCDDEEFF, 112233445566

# Where the cameras' frame_data feed lives. Default taps the stack's own `rmq` — correct when
# an upstream sfe-sp-mqtt-proxy already delivers the feed INTO this stack; point it at the
# camera site's broker instead to tap directly. NOTE: tapping a real site broker puts a real
# credential below — this file is tracked in git, so keep your site's value out of commits.
MCT_SOURCE_URI=mqtt://rmq:1883
MCT_SOURCE_USERNAME=guest
MCT_SOURCE_PASSWORD=guest
# One topic filter per camera: edge-stream/<clientId>/#
MCT_SOURCE_TOPICS=edge-stream/AABBCCDDEEFF/#,edge-stream/112233445566/#
# MUST be unique per proxy instance — default client ids collide across instances tapping the
# same broker (MQTT session takeover kicks both off).
MCT_SOURCE_CLIENT_ID=sfe-sp-mqtt-proxy-sceg-mct
