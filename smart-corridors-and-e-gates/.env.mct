# ── MCT overlay configuration (mct/docker-compose.yml) ──────────────────────────────────────
# Images: the released MCT suite, mirrored to Harbor digest-for-digest from the build registry —
# these are the same artefacts, not rebuilds of the same revision, so the tag identifies exactly
# what ran in testing. One tag covers every component, so an upgrade is a single change here,
# followed by re-running the `migrate` profile.
MCT_REGISTRY=registry.dot.innovatrics.com/border-control/
MCT_TAG=0.6.0.905

# Name of the calibration model the tracker and visualizer load. It must match a model present in
# the Config API — either seeded from ./mct/models_data by the `seed` profile, or imported by hand
# via http://localhost:8002/swagger. Until it exists the tracker runs but produces no tracks.
MCT_MODEL=my-corridor

# SFE Stream Processor client ids (camera MACs) of YOUR corridor cameras — comma+space list.
# Only the cameras listed here are consumed, even when the calibration model describes more.
MCT_CLIENT_IDS=AABBCCDDEEFF, 112233445566

# Python logging level for the tracker: DEBUG, INFO, WARNING, ERROR or CRITICAL. Nothing else is
# accepted — a .NET-style "Information" aborts the container at startup. DEBUG adds one line per
# ingested frame, which is how you confirm frames are arriving at all.
MCT_LOG_LEVEL=INFO

# Password for MCT's OWN Postgres (container `mct-postgres`). This is no longer the base stack's
# `pgsql` password: MCT keeps its calibration database separate, on its own named volume, so
# nothing here has to match vpp/sf_dependencies/docker-compose.yml. Not published off the host.
MCT_DB_PASSWORD=ChangeMe123

# ── Where the camera feed and the track stream live ───────────────────────────────────────────
# Both default to the base stack's `rmq`, resolved by name over `sf-network`:
#   MQTT (:1883) — the tracker SUBSCRIBES here for edge-stream/<clientId>/frame_data. Something has
#                  to deliver that feed into this broker; typically an sfe-sp-mqtt-proxy at the
#                  camera site publishes into it. Plain MQTT 3.1.1 — no MQTT 5 broker needed.
#   AMQP (:5672) — the tracker PUBLISHES the track stream here, and the Corridor Hub consumes it.
# Point MCT_MQTT_* at the camera site's own broker instead if you would rather have the tracker read
# the feed directly. Doing so puts a real credential in this file, which is tracked in git — keep
# your site's value out of commits.
MCT_MQTT_HOST=rmq
MCT_MQTT_PORT=1883
MCT_MQTT_USERNAME=guest
MCT_MQTT_PASSWORD=guest

MCT_RMQ_HOST=rmq
MCT_RMQ_PORT=5672
MCT_RMQ_USERNAME=guest
MCT_RMQ_PASSWORD=guest
