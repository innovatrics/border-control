# -----------------------------------------------------------------------------
# 1. Deployment
# -----------------------------------------------------------------------------
# Images are mirrored from the Innovatrics internal release registry into Harbor (see
# "The platform" in ../README.md). Must end with a forward slash. The images are still
# published under their VPP names; only the deployment has been rebranded so far.
REGISTRY=registry.dot.innovatrics.com/border-control/vpp/
VERSION=v5_4.43.0.10149
CameraServicesCount=5 # Number of camera services that get seeded by migration script

# -----------------------------------------------------------------------------
# 2. Shared configuration
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 2.1 Database
# -----------------------------------------------------------------------------
# DbEngine supported values: PgSql, MsSql
Database__DbEngine=PgSql
ConnectionStrings__CoreDbContext=Server=pgsql;Database=facematcher;Username=postgres;Password=Test1234;Trust Server Certificate=true;
Database__ExtendedCommandTimeoutSeconds=300

# -----------------------------------------------------------------------------
# 2.2 RabbitMQ (used by: all services)
# -----------------------------------------------------------------------------
RabbitMQ__Hostname=rmq
RabbitMQ__Username=guest
RabbitMQ__Password=guest
RabbitMQ__VirtualHost=/
RabbitMQ__Port=5672
RabbitMQ__UseSsl=false
# StreamsPort is read only by edge-streams-state-synchronizer and db-synchronization-*
RabbitMQ__StreamsPort=5552

# -----------------------------------------------------------------------------
# 2.3 MQTT broker (By default this is the RMQ broker with the MQTT plugin enabled)
# -----------------------------------------------------------------------------
MQTT__Hostname=rmq
MQTT__Username=guest
MQTT__Password=guest
MQTT__Port=1883
MQTT__UseSsl=false

# -----------------------------------------------------------------------------
# 2.4 S3 blob storage
#     used by: base, api, streamdatadbworker, cam, db-synchronization-leader,
#              db-synchronization-follower
# -----------------------------------------------------------------------------
S3Bucket__Endpoint=http://seaweedfs:8333
S3Bucket__BucketName=face-matcher
S3Bucket__AccessKey=admin
S3Bucket__SecretKey=admin
S3Bucket__Folder=sface
S3Bucket__BucketRegion=
# AuthenticationType: AccessKeyAndSecret (default), or for cloud: InstanceProfile, AssumedRole
S3Bucket__AuthenticationType=AccessKeyAndSecret
# Set true in cloud deployments to use the real S3 bucket for the configured region
S3Bucket__UseBucketRegion=false

# -----------------------------------------------------------------------------
# 2.5 Hosting (used by: api, graphql-api, db-synchronization-leader)
#     We use port 80 inside docker and forward it to host ports as needed.
# -----------------------------------------------------------------------------
Hosting__Host=http://0.0.0.0
Hosting__Port=8080
AllowedHosts=*

# -----------------------------------------------------------------------------
# 2.6 Health checks (used by: all services)
#     db / rmq tags are evaluated only by api and graphql-api. Set a tag to false
#     to skip that health check for deployments that run without the dependency.
# -----------------------------------------------------------------------------
HealthCheck__Host=*
HealthCheck__Port=6060
HealthCheck__Tags__db=true
HealthCheck__Tags__rmq=true

# -----------------------------------------------------------------------------
# 2.7 Logging (used by: all services)
# -----------------------------------------------------------------------------
AppSettings__Log_JsonConsole_Enabled=true
AppSettings__Log_RollingFile_Enabled=false
AppSettings__Log_RollingFile_Directory=/tmp
AppSettings__Log_RollingFile_MaxSizeMB=100
AppSettings__Log_RollingFile_MaxFiles=10
AppSettings__Log_RabbitMq_Enabled=false
Serilog__MinimumLevel__Default=Information
# Override__Microsoft baseline is Information; api, extractor, liveness and
# edge-stream-processor run it at Debug, set explicitly on those services in docker-compose.
Serilog__MinimumLevel__Override__Microsoft=Information
Serilog__MinimumLevel__Override__Microsoft.AspNetCore=Warning
Serilog__MinimumLevel__Override__Microsoft.Hosting.Lifetime=Information
Serilog__MinimumLevel__Override__System=Warning

# -----------------------------------------------------------------------------
# 2.8 Tracing & metrics (OpenTelemetry)
#     Standard OTel SDK env vars: https://opentelemetry.io/docs/specs/otel/configuration/sdk-environment-variables/
#     OTEL_EXPORTER_PROMETHEUS_HOST / _PORT are supported by our services even
#     though they are not part of the standard supported set.
# -----------------------------------------------------------------------------
Tracing__Enabled=false
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# Jaeger or other OTel tracing endpoint. 'jaeger' is the name of the included docker container.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_METRICS_EXPORTER=prometheus
OTEL_EXPORTER_PROMETHEUS_HOST=*
OTEL_EXPORTER_PROMETHEUS_PORT=4318
# Collected only by RPC services, base, matcher and face-matcher.
Metrics__RequestsProcessingTimeHistogramBands="100, 200, 500, 1000, 2500, 5000"

# -----------------------------------------------------------------------------
# 2.9 GPU (used by: base, cam, detector, extractor, liveness,
#          pedestrian-detector, pedestrian-extractor, object-detector)
# -----------------------------------------------------------------------------
Gpu__GpuEnabled=false
# Index of the GPU on the host machine
Gpu__GpuDeviceIndex=0
Gpu__GpuNeuralRuntime=Default

# -----------------------------------------------------------------------------
# 2.10 IFace engine threading
#      used by: base, cam, detector, extractor, liveness, face-matcher,
#               pedestrian-detector
# -----------------------------------------------------------------------------
IFaceConfiguration__ThreadNum=1
IFaceConfiguration__ThreadManagementMode=min_memory

# -----------------------------------------------------------------------------
# 2.11 ONNX runtime threading – number of threads the solver uses for CPU ONNX
#      processing (used by: detector, extractor, liveness, object-detector,
#      pedestrian-detector, pedestrian-extractor, edge-stream-processor).
# -----------------------------------------------------------------------------
OnnxRuntimeConfiguration__SolverInterThreads=1
OnnxRuntimeConfiguration__SolverIntraThreads=1

# -----------------------------------------------------------------------------
# 2.12 NoSQL data storage toggle
#      used by: base, api, cam, streamdatadbworker, edge-stream-processor,
#               edge-streams-state-synchronizer
# -----------------------------------------------------------------------------
NoSqlDataStorageDisabled=false

# -----------------------------------------------------------------------------
# 2.13 Detection save strategies (used by: cam, edge-stream-processor)
# -----------------------------------------------------------------------------
BalancedFaceStrategy__QualityStep=1000
BalancedFaceStrategy__MatchScoreStep=10
MatchedOnlyFaceStrategy__MatchScoreStep=10
BalancedPedestrianStrategy__QualityStep=1000
BalancedGenericObjectStrategy__QualityStep=1000
BalancedGenericObjectStrategy__MatchScoreStep=10
MatchedOnlyObjectStrategy__MatchScoreStep=10

# -----------------------------------------------------------------------------
# 2.14 Crop background color (used by: cam, detector, pedestrian-detector)
# -----------------------------------------------------------------------------
CropConfiguration__BackgroundColor=#424B59

# -----------------------------------------------------------------------------
# 2.15 Notifications (used by: cam, graphql-api, edge-stream-processor)
# -----------------------------------------------------------------------------
# Face Matcher's own clients and the Smart Corridors Hub/CIGS read face templates off the
# GraphQL notifications, so templates are included by default.
Notifications__IncludeTemplates=true

# -----------------------------------------------------------------------------
# 2.16 Object linking (used by: cam, edge-stream-processor)
# -----------------------------------------------------------------------------
ObjectLinking__Enabled=true

# -----------------------------------------------------------------------------
# 2.17 Spoof detection (used by: cam, edge-stream-processor)
#      Applies to server-computed liveness only. Set false to evaluate liveness
#      on every face instead of only on matched faces.
#      Edge streams computing liveness on the device are unaffected; those are
#      governed by the edge stream's own liveness strategy.
# -----------------------------------------------------------------------------
SpoofDetection__SkipUnidentified=true

# -----------------------------------------------------------------------------
# 2.18 RPC messaging timeout (used by: cam, edge-stream-processor, api,
#      edge-streams-state-synchronizer)
#      Common default below. api (6000) and edge-streams-state-synchronizer
#      (10000) use their own values, set explicitly on those services in docker-compose.
# -----------------------------------------------------------------------------
Rpc__TimeoutMs=3000


# -----------------------------------------------------------------------------
# 3. Per-service configuration
#      Section numbers match the upstream VPP release so that its settings stay easy to
#      look up; the gaps are the services Face Matcher does not deploy (grouping, the
#      offline video trio, palm detection).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 3.1 Base (SFBase)
# -----------------------------------------------------------------------------
DbCleanUp__BatchSize=1000
VideoRecordSlicing__ChunkLength=00:10:00
TrackletRecovery__TrackletRecoveryTriggerPeriodSeconds=30
TrackletRecovery__MinimumVisualObjectAgeForTrackletRecoverySeconds=120

# -----------------------------------------------------------------------------
# 3.2 REST API (api)
# -----------------------------------------------------------------------------
# Camera preview port. Empty = dynamic per-camera default (30000 + stream sequence).
# Set a fixed number only to force a static preview port for every camera.
CameraDefaults__PreviewPort=

# Enabled feature set / relevant endpoints
FeatureManagement__Watchlist=false
FeatureManagement__Edge=false
FeatureManagement__Full=true
FeatureManagement__Detection=false
# Watchlists/WatchlistMembers endpoints can be made read-only (disables PUT/POST/DELETE)
FeatureManagement__ReadOnlyWatchlists=false

# Internal toggle for the api/v1/WatchlistMembers/{id}/Totp/QrCode endpoint
Totp__QrCodeImageEndpointEnabled=false
Totp__Digits=6
Totp__PeriodSeconds=30
Totp__Algorithm=SHA1

# Vector DB (Provider supported values: none, milvus)
VectorDB__Provider=none
# How many nearest embeddings are fetched internally during matching
# (n times RerankQueryLimitA plus RerankQueryLimitB). Increase for better
# accuracy on very large watchlists.
VectorDB__RerankQueryLimitA=2
VectorDB__RerankQueryLimitB=5
Milvus__Endpoint=http://milvus:19530
# Milvus authentication is on by default. Set Milvus__UseAuthentication=false to connect anonymously to a
# Milvus with authorization disabled (the credentials below are then ignored).
Milvus__UseAuthentication=true
# Provide a Username+Password, or a Token (API key) which takes precedence over Username/Password.
Milvus__Username=vpp
Milvus__Password=secret123
Milvus__Token=

# Enrollment from an image URI: the API downloads the image over HTTP(S).
ImageDownload__TimeoutMs=10000
ImageDownload__MaxImageSizeBytes=10485760
# Comma separated list of hosts the images may be downloaded from,
# e.g.: images.example.com,*.cdn.com:8443
ImageDownload__AllowedHosts=*
# How many images of a single enrollment request may be downloaded in parallel.
ImageDownload__MaxParallelDownloads=5

# Maximum number of images accepted in a single watchlist member registration request.
WatchlistMemberRegistration__MaxImages=50

# Watchlist deletion runs in the background and unlinks members in batches.
WatchlistDeleter__WatchlistMemberUnlinkBatchSize=1000

# FaceValidation for enrollment (predefined values)
FaceValidation__Size__Min=30
FaceValidation__Size__Max=
FaceValidation__AreaOnFrame__Min=
FaceValidation__AreaOnFrame__Max=
FaceValidation__TemplateQuality__Min=10
FaceValidation__TemplateQuality__Max=
FaceValidation__FaceQuality__Min=1000
FaceValidation__FaceQuality__Max=10000
FaceValidation__YawAngle__Min=-20
FaceValidation__YawAngle__Max=20
FaceValidation__PitchAngle__Min=-20
FaceValidation__PitchAngle__Max=20
FaceValidation__RollAngle__Min=-20
FaceValidation__RollAngle__Max=20
FaceValidation__Brightness__Min=
FaceValidation__Brightness__Max=
FaceValidation__Sharpness__Min=
FaceValidation__Sharpness__Max=

# Transaction Counting System (TCS) statistics.
# When statistics sending is enabled you must also set TransactionCountingSystemUrl
# and one form of authentication (Authentication__CrmToken OR Authentication__OAuth).
Statistics__SendStatisticsData=false
Statistics__TransactionCountingSystemUrl=https://your-tcs.innovatrics.com
# Long-lived per-customer token. When set, any Statistics__Authentication__OAuth__* is ignored.
Statistics__Authentication__CrmToken=
Statistics__Authentication__OAuth__TokenEndpoint=https://your-auth0-instance.com/oauth/token
Statistics__Authentication__OAuth__Audience=
Statistics__Authentication__OAuth__ClientId=
Statistics__Authentication__OAuth__ClientSecret=
Statistics__TransactionsPublishBatchSize=1000
Statistics__TransactionsPublishTimeoutMs=5000
Statistics__TransactionsPublishIntervalMs=5000
Statistics__TransactionsPublishRetryBackoffMs=3000

# -----------------------------------------------------------------------------
# 3.3 Authentication & multitenancy (used by: api, graphql-api)
#     Authority is the Auth0 / Keycloak issuer url. TenantClaimName must be
#     configured in the authentication provider (Keycloak/Auth0).
# -----------------------------------------------------------------------------
Authentication__UseAuthentication=false
Authentication__IgnoreHttpsIssuerCheck=false
Authentication__Authority=
Authentication__Audience=
Authentication__SwaggerAuthConfig__ClientCredsTokenUrl=
Authentication__SwaggerAuthConfig__AuthCodeTokenUrl=
Authentication__SwaggerAuthConfig__AuthCodeAuthorizeUrl=
Multitenancy__UseMultitenancy=false
Multitenancy__TenantClaimName=sf-cm-tenant-id

# -----------------------------------------------------------------------------
# 3.5 StreamDataDbWorker (streamdatadbworker)
# -----------------------------------------------------------------------------
StreamDataConsumer__BlobProcessorCount=16
StreamDataConsumer__BatchSize=200

# -----------------------------------------------------------------------------
# 3.6 Camera (cam)
# -----------------------------------------------------------------------------
GstPipelineTemplate={0}
# Linux
#GstPipelineTemplate=uridecodebin uri={0} source::latency=0 ! queue max-size-buffers=1 leaky=downstream ! nvvideoconvert ! video/x-raw, format=(string)BGRx ! videoconvert ! video/x-raw, format=(string)BGR ! appsink
# Jetson
#GstPipelineTemplate_Jetson=uridecodebin uri={0} source::latency=0 ! queue max-size-buffers=1 leaky=downstream ! nvvidconv ! video/x-raw, format=(string)BGRx ! videoconvert ! video/x-raw, format=(string)BGR ! appsink

StreamVisualization__StreamOnlyProcessed=false
StreamVisualization__BufferingFramesCount=15
StreamVisualization__InterpolateBoundingBoxes=false
TrackingConfiguration__MaxOldnessDetectionFrames=2

# -----------------------------------------------------------------------------
# 3.7 EdgeStreamProcessor (edge-stream-processor)
# -----------------------------------------------------------------------------
FrameDataProcessing__ForceExtractionOfIncompatibleFaceTemplates=false
EdgeStreamRmqConsumer__ExchangeName=amq.topic
EdgeStreamRmqConsumer__QueueName=MQTT_EDGE_STREAM_CONSUMER
EdgeStreamRmqConsumer__RoutingKey=edge-stream.*.frame_data

# -----------------------------------------------------------------------------
# 3.8 EdgeStreamsStateSynchronizer (edge-streams-state-synchronizer)
# -----------------------------------------------------------------------------
# Number of messages from the update-log stream to read at once
SynchronizationConfig__UpdateLogReadBatchCount=1000
# Max time (ms) to wait when a batch can't be filled before triggering it anyway
SynchronizationConfig__BatchTriggerMs=1000

# -----------------------------------------------------------------------------
# 3.12 RpcDetector (detector)
#      Supported values: "fast,balanced_mask,accurate_mask" (comma-separated).
# -----------------------------------------------------------------------------
Warmup__DetectionAlgorithms=balanced_mask

# -----------------------------------------------------------------------------
# 3.13 RpcExtractor (extractor)
#      Refer to documentation for supported algorithms and model versions.
# -----------------------------------------------------------------------------
Extraction__Algorithm=balanced

# -----------------------------------------------------------------------------
# 3.14 RpcLiveness (liveness)
#      Warmup__LivenessAlgorithms supported values: "Distant,Nearby" (comma-separated)
# -----------------------------------------------------------------------------
Liveness__DistantAlgorithm=fast
Warmup__LivenessAlgorithms=Distant,Nearby

# -----------------------------------------------------------------------------
# 3.15 RpcFaceMatcher (face-matcher)
# -----------------------------------------------------------------------------
FaceMatcher__SeedPageSize=50000

# -----------------------------------------------------------------------------
# 3.16 RpcWatchlistMatcher (matcher)
# -----------------------------------------------------------------------------
WatchlistMatcher__SeedPageSize=50000
Matching__ThreadCount=4
Multitenancy__TenantId=default

# -----------------------------------------------------------------------------
# 3.17 RpcObjectDetector (object-detector)
#      Detection__Algorithm supported values: balanced, fast, accurate.
# -----------------------------------------------------------------------------
Detection__Algorithm=balanced
Detection__ClassThreshold=5000

# -----------------------------------------------------------------------------
# 3.19 RpcPedestrianExtractor (pedestrian-extractor)
#      Attribute interpretation when extracting attributes (see docs).
# -----------------------------------------------------------------------------
Extraction__Attributes__AppendInterpretedAttributesUnderLowerThreshold=false
Extraction__Attributes__AppendConfidenceAttributes=false
Extraction__Attributes__AppendInterpretedAttributes=true
Extraction__Attributes__InterpretationThresholds__CommonThresholdUpper=8000
Extraction__Attributes__InterpretationThresholds__CommonThresholdLower=4000
Extraction__Attributes__InterpretationThresholds__GlassesThresholdUpper=8000
Extraction__Attributes__InterpretationThresholds__GlassesThresholdLower=4000
Extraction__Attributes__InterpretationThresholds__HoldThresholdUpper=7000
Extraction__Attributes__InterpretationThresholds__HoldThresholdLower=3000

# -----------------------------------------------------------------------------
# 3.20 DbSynchronizationLeader (db-synchronization-leader)
# -----------------------------------------------------------------------------
Kestrel__EndpointDefaults__Protocols=Http2
Synchronization__BatchUpdateLogReadSize=1000
Synchronization__BatchTriggerTimeoutMs=1000
Synchronization__MaxBatchWaitTimeMs=2000

# -----------------------------------------------------------------------------
# 3.21 DbSynchronizationFollower (db-synchronization-follower)
#      Leader__Address is the gRPC server address of the leader.
#      ClientAuthentication__Audience is optional (required if using Auth0).
# -----------------------------------------------------------------------------
Leader__Address=http://example-leader-hostname:8100
Leader__RequestBatchSize=1000
ClientAuthentication__UseAuthentication=false
ClientAuthentication__TokenEndpoint=
ClientAuthentication__ClientId=
ClientAuthentication__ClientSecret=
ClientAuthentication__Audience=
