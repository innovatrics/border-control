# Face Matcher module configuration.
#
# The platform's own settings (engine, cameras, database, storage) live in platform/.env.
# This file configures only what sits on top of it: Face Matcher Station.

# Registry prefix for the Station image. Same Harbor project as the platform images; the
# images still carry their VPP names because the image rebrand has not shipped yet.
REGISTRY=registry.dot.innovatrics.com/border-control/vpp/

# Face Matcher Station (the SmartFace Station build) image tag.
STATION_VERSION=v5_1.33.0

# Host port for Station.
STATION_PORT=8000

# Branding assets mounted into Station, relative to this folder. A stack built on top of
# Face Matcher overrides this to point at its own folder — Smart Corridors & e-Gates does.
STATION_BRANDING=./branding/station

# Station's Identification page (1:N search of an uploaded face against the watchlists).
# On by default: it is Face Matcher's core operator workflow.
STATION_IDENTIFICATION=true
