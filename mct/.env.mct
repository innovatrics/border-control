# MCT overlay (mct/docker-compose.yml). One tag covers every image; after raising it, run the migrate profile.
MCT_REGISTRY=registry.dot.innovatrics.com/border-control/
MCT_TAG=0.6.0.905

# Calibration model to load. Seeded from mct/models_data by the seed profile, or imported through the Config API.
MCT_MODEL=my-corridor

# SFE Stream Processor client ids (camera MACs) of the corridor cameras, comma-separated.
MCT_CLIENT_IDS=AABBCCDDEEFF, 112233445566

# DEBUG, INFO, WARNING, ERROR or CRITICAL. DEBUG logs every ingested frame.
MCT_LOG_LEVEL=INFO

# MCT's own PostgreSQL (container mct-postgres), not published off the host.
MCT_DB_PASSWORD=ChangeMe123

# Brokers. Both default to Face Matcher's rmq: MQTT for the camera feed the tracker subscribes to,
# AMQP for the track stream the tracker publishes and the Hub consumes.
MCT_MQTT_HOST=rmq
MCT_MQTT_PORT=1883
MCT_MQTT_USERNAME=guest
MCT_MQTT_PASSWORD=guest

MCT_RMQ_HOST=rmq
MCT_RMQ_PORT=5672
MCT_RMQ_USERNAME=guest
MCT_RMQ_PASSWORD=guest
